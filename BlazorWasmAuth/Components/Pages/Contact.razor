@page "/contact"
@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Resource> Localizer

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
	<MudText Typo="Typo.h4" GutterBottom="true">
		@Localizer["ContactUsTitle"]
	</MudText>

	<MudText Typo="Typo.body1" Class="mb-6">
		@Localizer["ContactUsText"]
	</MudText>
	<MudGrid Spacing="3" Class="d-flex flex-wrap">
		<MudItem xs="12" sm="6" Class="d-flex">
			<ContactCard
				Title="Email"
				Color="Color.Primary"
				Text="@Localizer["ContactUsEmailDescription"]"
				Link="mailto:hello@actioreact.io"
				LinkText="hello@actioreact.io"
				Icon="@Icons.Material.Filled.Email"
				Class="flex-grow-1"/>
		</MudItem>
		<MudItem xs="12" sm="6" Class="d-flex">
			<ContactCard Title="Bug"
			             Color="Color.Primary"
			             Text="@Localizer["ContactUsBugDescription"]"
			             Link="mailto:bug@actioreact.io"
			             LinkText="bug@actioreact.io"
			             Icon="@Icons.Material.Filled.BugReport"
			             Class="flex-grow-1"/>
		</MudItem>
		<MudItem xs="12" sm="6" Class="d-flex">
			<ContactCard Title="Feature"
			             Color="Color.Primary"
			             Text="@Localizer["ContactUsFeatureDescription"]"
			             Link="mailto:feature@actioreact.io"
			             LinkText="feature@actioreact.io"
			             Icon="@Icons.Material.Filled.Star"
			             Class="flex-grow-1"/>
		</MudItem>
	</MudGrid>

</MudContainer>
