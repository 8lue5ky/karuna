@page "/post/new"

@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject ISnackbar Snackbar
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["CreatePostHeader"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
    <MudPaper Class="pa-6 rounded-lg" Outlined="true">
        <MudStack Spacing="3">
			<MudText Typo="Typo.h5" GutterBottom="true">@Localizer["CreatePostHeader"]</MudText>

            <MudForm @ref="_form">
	            <MudTextField @bind-Value="_model.Title"
	                          Label="@Localizer["PostTitle"]"
	                          Variant="Variant.Outlined"
	                          Required="true"
	                          For="@(() => _model.Title)"/>

	            <MudTextField @bind-Value="_model.Description"
							  Label="@Localizer["PostDescription"]"
	                          Variant="Variant.Outlined"
	                          Lines="5"
	                          For="@(() => _model.Description)"
							  HelperText="@Localizer["PostDescriptionHelpText"]"
	                          Required="true"/>
				<MudSelect @bind-Value="_model.Type" Label="@Localizer["PostType"]" Variant="Variant.Outlined" For="@(() => _model.Type)" Required="true">
		            <MudSelectItem Value="@(PostType.Actio)">
			            <div class="d-flex align-center">
				            <MudIcon Class="mr-1" Icon="@Icons.Material.Filled.VolunteerActivism" />
				            Actio
			            </div>
		            </MudSelectItem>
		            <MudSelectItem Value="@(PostType.Reactio)">
			            <div class="d-flex align-center">
				            <MudIcon Class="mr-1" Icon="@Icons.Material.Filled.AutoAwesome" />
				            Reactio
			            </div>
		            </MudSelectItem>
	            </MudSelect>
	            <MudStack Row="true" Spacing="2" Class="pt-4">
		            <MudButton OnClick="SubmitAsync"
		                       Color="Color.Primary"
		                       Variant="Variant.Filled"
		                       Disabled="@_isSubmitting">
			            <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Class="me-2"/>
			            Post
		            </MudButton>

		            <MudButton OnClick="ResetForm"
		                       Color="Color.Secondary"
		                       Variant="Variant.Outlined">
			            Reset
		            </MudButton>
	            </MudStack>
            </MudForm>
        </MudStack>
    </MudPaper>
</MudContainer>