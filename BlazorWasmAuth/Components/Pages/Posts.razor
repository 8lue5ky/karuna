@page "/posts"
@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization
@inject PostsServiceClient ServiceClient
@inject ISnackbar Snackbar
@inject IStringLocalizer<Resource> Localizer
@inject FooterService FooterService

<MudContainer Class="mt-2 px-0">
    <div>
		 
	  @*   <MudDivider Class="mb-3" />
	    <!-- Sorting Chips -->
	    <div class="d-flex align-center mb-3">
		    <MudChipSet T="String"
		                SelectedColor="Color.Primary">

			    <MudChip Value="@("Newest")">Newest</MudChip>
			    <MudChip Value="@("Trending")">Trending</MudChip>

		    </MudChipSet>
	    </div>

	    <MudDivider Class="mb-3" /> *@
		
		 @if (_pullDistance > 0 && !_isRefreshing)
		 {
			  <div style="
						height:@($"{Math.Min(_pullDistance, 70)}px");
						transition:height .1s;
						display:flex;
						align-items:center;
						justify-content:center;
						overflow:hidden;">
				  <MudProgressCircular Indeterminate="false"
				                       Value="@Math.Min(100, _pullDistance / 70 * 100)" 
				                       Color="Color.Primary" />
			  </div>
		 }

		@if (_isRefreshing)
		{
			  <div class="d-flex justify-center my-2">
				  <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
			  </div>
		}
			  
		@foreach (var post in posts)
        {
            <Post PostModel="@post"/>
        }

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
        }

        @if (_allLoaded)
        {
            <MudText Typo="Typo.caption" Align="Align.Center" Class="text-gray-500 my-2">
				@Localizer["NoMorePosts"]
            </MudText>
        }
		
        <MudScrollToTop>
	        <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
        </MudScrollToTop>

    </div>
</MudContainer> 