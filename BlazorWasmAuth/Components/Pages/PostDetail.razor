@page "/post/{PostId:guid}"
@using Frontend.Components.Pages.Comments
@using Shared.DTOs.Posts
@inject PostsServiceClient _serviceClient;
@inject NavigationManager Nav

<MudContainer>
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_post == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">Post nicht gefunden.</MudText>
    }
    else
    { 
	    <Post PostModel="@_post"></Post>

	    <!-- COMMENTS -->
	    <MudPaper Class="pa-5 mt-5 rounded-lg" Outlined="true">
	        <MudText Typo="Typo.h6" Class="mb-4">Kommentare</MudText>

				<CommentEditor PostId="@_post.Id" OnCreated="ReloadComments" />

	        <MudDivider Class="my-4" />

				<CommentList PostId="@_post.Id" @ref="_commentList" />
	    </MudPaper>

    }
</MudContainer>

@code {
    [Parameter] public Guid PostId { get; set; }

    private PostDto? _post;
    private bool _loading = true;
    private CommentList? _commentList;

    protected override async Task OnInitializedAsync()
    {
        _post = await _serviceClient.GetPost(PostId);
        _loading = false;
    }

    private async Task ReloadComments()
    {
        if (_commentList != null)
            await _commentList.SetParametersAsync(ParameterView.Empty);
    }
}
