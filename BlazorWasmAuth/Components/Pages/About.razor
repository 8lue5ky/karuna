@page "/about"

@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Resource> Localizer

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">

    <!-- Title -->
    <MudText Typo="Typo.h4" GutterBottom="true">
        @Localizer["About_Title"]
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
        @Localizer["About_Intro"]
    </MudText>

    <!-- Actio -->
    <MudText Typo="Typo.h6" Class="mt-8">
        Actio
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
        @Localizer["Actio_Description"]
    </MudText>

    <!-- Reactio -->
    <MudText Typo="Typo.h6" Class="mt-8">
        Reactio
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
        @Localizer["Reactio_Description"]
    </MudText>

    <!-- Why -->
    <MudText Typo="Typo.h6" Class="mt-8">
        @Localizer["Why_Title"]
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
        @Localizer["Why_Description"]
    </MudText>

    <!-- Feed explanation -->
    <MudText Typo="Typo.h6" Class="mt-8">
        @Localizer["Feed_Title"]
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-4">
        @Localizer["Feed_Intro"]
    </MudText>

    <MudList T="string" Dense="true" Class="mb-6">
        <MudListItem>
            <MudText Typo="Typo.body1">
                <strong>@Localizer["Feed_Actio_Label"]</strong>
                — @Localizer["Feed_Actio_Description"]
            </MudText>
        </MudListItem>

        <MudListItem>
            <MudText Typo="Typo.body1">
                <strong>@Localizer["Feed_Reactio_Label"]</strong>
                — @Localizer["Feed_Reactio_Description"]
            </MudText>
        </MudListItem>
    </MudList>

    <MudText Typo="Typo.body1" Class="mb-8">
	    @Localizer["Feed_Outro"]
    </MudText>
	
    <MudDivider Class="my-8" />

    <MudText Typo="Typo.h6">
	    @Localizer["Join_Title"]
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
	    @Localizer["Join_Description"]
    </MudText>

</MudContainer>
