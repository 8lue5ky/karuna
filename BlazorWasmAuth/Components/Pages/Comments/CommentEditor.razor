@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization
@using Shared.DTOs.Comments

@inject CommentServiceClient Comments
@inject IStringLocalizer<Resource> Localizer

<AuthorizeView>
	<Authorized>
		<MudStack Spacing="2">
			<MudTextField @bind-Value="_content"
				Label="@Localizer["CreateComment"]"
				Variant="Variant.Outlined"
				Lines="3"
				FullWidth="true"
				Adornment="Adornment.Start"
				AdornmentIcon="@Icons.Material.Filled.Comment"
			/>

			<MudButton 
				Variant="Variant.Filled"
				Color="Color.Primary"
					   Disabled="@string.IsNullOrWhiteSpace(_content)"
					   OnClick="Submit"
				StartIcon="@Icons.Material.Filled.Send">
				@Localizer["SubmitComment"]
			</MudButton>
		</MudStack>
	</Authorized>

	<NotAuthorized>
		<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
			@Localizer["LogInToWriteAComment"]
		</MudAlert>
	</NotAuthorized>
</AuthorizeView>



@code {
	[Parameter] public Guid PostId { get; set; }
	[Parameter] public EventCallback OnCreated { get; set; }

	private string? _content;

	private async Task Submit()
	{
		var dto = new CreateCommentDto
		{
			PostId = PostId,
			Content = _content!
		};

		var id = await Comments.CreateAsync(dto);
		if (id != null)
		{
			_content = "";
			await OnCreated.InvokeAsync();
		}
	}
}