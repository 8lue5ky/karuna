@using Frontend.Identity
@using Shared.DTOs.Comments
@inject CommentServiceClient Comments
@inject AuthenticationStateProvider AuthState

@if (_loading)
{
	<MudProgressCircular Indeterminate="true" />
}
else if (_comments is null || _comments.Count == 0)
{
	<MudText Color="Color.Secondary">Keine Kommentare.</MudText>
}
else
{
	<MudList T="CommentDto" Dense="false">
		@foreach (var c in _comments)
		{
			<MudListItem>
				<MudPaper Elevation="0" Class="pa-3 mb-2 rounded-lg" Outlined="true">
					<MudStack Spacing="1">
						<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
							<MudAvatar Size="Size.Medium">@c.UserName[0]</MudAvatar>
							<MudStack>
								<MudText Typo="Typo.subtitle2">@c.UserName</MudText>
								<MudText Typo="Typo.caption" Color="Color.Secondary">@c.CreatedAt</MudText>
							</MudStack>
						</MudStack>

						<MudText Typo="Typo.body2" Class="mt-1">@c.Content</MudText>

						<AuthorizeView>
							<Authorized>
								@if (_currentUserName == c.UserName)
								{
									<MudButton Variant="Variant.Text"
									           Color="Color.Error"
									           StartIcon="@Icons.Material.Filled.Delete"
									           OnClick="() => Delete(c.Id)"
									           Class="mt-1">
										Löschen
									</MudButton>
								}
							</Authorized>
						</AuthorizeView>
					</MudStack>
				</MudPaper>
			</MudListItem>
		}
	</MudList>
}


@code {
	[Parameter] public Guid PostId { get; set; }

	private List<CommentDto>? _comments;
	private string? _currentUserName;
	private bool _loading;

	protected override async Task OnParametersSetAsync()
	{
		_loading = true;

		var state = await AuthState.GetAuthenticationStateAsync();

		// TODO: Not working Username instead of display name
		_currentUserName = state.User.Identity?.IsAuthenticated == true
			? state.User.Identity!.Name
			: null;

		_comments = await Comments.GetCommentsAsync(PostId);

		_loading = false;
	}

	private async Task Delete(Guid id)
	{
		if (await Comments.DeleteAsync(id))
		{
			_comments!.RemoveAll(c => c.Id == id);
			StateHasChanged();
		}
	}
}