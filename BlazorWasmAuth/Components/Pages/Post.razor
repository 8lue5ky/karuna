@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resource> Localizer

<MudPaper Class="pa-4 my-3 rounded-lg" Outlined="true" Elevation="1" @onclick="GoToDetails">
	<MudStack Spacing="2">
		<!-- Header -->
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
				<MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
					<MudImage Src="@GetThumbnailUrl()" Height="64" Width="64"></MudImage>
				</MudAvatar>
				<MudStack Spacing="1" >
					<MudText Typo="Typo.subtitle2" Class="font-semibold">@UserName</MudText>
					<MudText Typo="Typo.caption" Class="text-muted">@TimeAgo</MudText>
				</MudStack>
			</MudStack>
			
			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

				@if (IsExamplePost)
				{
					<MudChip T="string" 
					         Size="Size.Small"
					         Color="Color.Info"
					         Variant="Variant.Outlined"
					         Label="true"
					         Ripple="false">
						@Localizer["Example"]
					</MudChip>
				}

				<MudMenu Icon="@Icons.Material.Filled.MoreVert"
				         AnchorOrigin="Origin.TopRight"
				         TransformOrigin="Origin.TopRight">
					<MudMenuItem>@Localizer["ReportPost"]</MudMenuItem>

					<AuthorizeView Roles="Administrator">
						<MudMenuItem OnClick="DeletePost">@Localizer["DeletePost"]</MudMenuItem>
					</AuthorizeView>

				</MudMenu>

			</MudStack>
		</MudStack>

		<!-- Content -->
		<MudStack>
			<MudText Typo="Typo.h6" >@PostModel.Title</MudText>
			<MudText Typo="Typo.body1" >@PostModel.Description</MudText>
		</MudStack>

		<!-- Footer -->
		<MudDivider Class="my-2" />
		<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
				
				<AuthorizeView>
					<Authorized>
						<MudIconButton
							Icon="@GetLikeIcon()"
							Color="@GetLikeColor()"
							OnClick="ToggleLike"
							Size="Size.Small"/>
					</Authorized>
					<NotAuthorized>
						<MudIconButton Icon="@Icons.Material.Outlined.FavoriteBorder"
									   Color="Color.Default"
									   Href="login"
									   Size="Size.Small"/>
					</NotAuthorized>
				</AuthorizeView>

				<MudText Typo="Typo.body2">@PostModel.LikeCount</MudText>
			</MudStack>

			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
				<MudIconButton Icon="@Icons.Material.Filled.Comment" Size="Size.Small" />
				<MudText Typo="Typo.body2">@PostModel.CommentCount</MudText>
			</MudStack>
		</MudStack>
	</MudStack>
</MudPaper>