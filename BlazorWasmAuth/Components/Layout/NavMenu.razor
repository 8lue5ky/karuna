@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Resource> Localizer

<MudNavMenu Rounded="true" >
	<MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
	<MudNavLink Href="post/new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PostAdd">@Localizer["NewPost"]</MudNavLink>
	<MudNavLink Href="about" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Info">@Localizer["About"]</MudNavLink>
	<MudNavLink Href="contact" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Email">@Localizer["Contact"]</MudNavLink>
</MudNavMenu>