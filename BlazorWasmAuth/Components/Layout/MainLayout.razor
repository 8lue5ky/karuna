@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
	@* AppBar *@
	<MudAppBar Elevation="0" Class="appbar-centered" Fixed="true">

		<MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center">

			<MudHidden Breakpoint="Breakpoint.MdAndUp">
				<MudIconButton Icon="@Icons.Material.Filled.Menu"
				               Color="Color.Inherit"
				               Edge="Edge.Start"
				               OnClick="DrawerToggle"/>
			</MudHidden>
			<MudImage Src="images/logo.png" Height="32" Width="32"></MudImage>
			<MudText Typo="Typo.h5" Class="ml-3">ActioReact.io</MudText>
			<MudSpacer/>

			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<AuthorizeView>
					<Authorized>
						<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Href="post/new">New post</MudButton>
					</Authorized>
					<NotAuthorized>
						<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Href="login">New post</MudButton>
					</NotAuthorized>
				</AuthorizeView>
			</MudHidden>

			<MudHidden Breakpoint="Breakpoint.MdAndUp">
				<AuthorizeView>
					<Authorized>
						<MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Href="post/new"></MudIconButton>
					</Authorized>
					<NotAuthorized>
						<MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Href="login"></MudIconButton>
					</NotAuthorized>
				</AuthorizeView>
			</MudHidden>

			<MudHidden Breakpoint="Breakpoint.MdAndUp">
				<MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" OnClick="@OpenSettingsToggle"/>
			</MudHidden>
			
			@* Settings menu desktop *@
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<MudMenu Icon="@Icons.Material.Filled.MoreVert">
					<AuthorizeView>
						<NotAuthorized>
							<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pl-4 py-2">
								<MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small"/>
								<MudText>Dark mode</MudText>
								<MudSwitch T="bool" @bind-Value="_isDarkMode"
								           Color="Color.Primary"
								           Ripple="true"
								           Class="ms-auto"/>
							</MudStack>
							<MudMenuItem Href="login" Icon="@Icons.Material.Filled.Login">Login</MudMenuItem>
							<MudMenuItem Href="register" Icon="@Icons.Material.Filled.AccountBox">Register</MudMenuItem>
						</NotAuthorized>
						<Authorized>
							<MudMenuItem Href="edit" Icon="@Icons.Material.Filled.Edit">My Profile</MudMenuItem>
							<MudDivider></MudDivider>
							<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pl-4 py-2">
								<MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small"/>
								<MudText>Dark mode</MudText>
								<MudSwitch T="bool" @bind-Value="_isDarkMode"
								           Color="Color.Primary"
								           Ripple="true"
								           Class="ms-auto"/>
							</MudStack>
							<MudMenuItem Href="logout" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
						</Authorized>
					</AuthorizeView>
				</MudMenu>
			</MudHidden>
		</MudContainer>
	</MudAppBar>

	<MudMainContent>

		<MudHidden Breakpoint="Breakpoint.MdAndUp">
			<!-- MOBILE: ohne Container -> volle Breite -->
			<MudGrid Justify="Justify.Center">
				<MudItem xs="12">
					@Body
				</MudItem>
			</MudGrid>
		</MudHidden>

		<MudHidden Breakpoint="Breakpoint.SmAndDown">
			<MudContainer>
				<MudGrid Justify="Justify.Center" Class="pt-6">

					@* Left area (navigation)*@
					<MudHidden Breakpoint="Breakpoint.SmAndDown">

						<MudItem xs="0" md="2">
							<MudPaper Elevation="0" Class="nav-sticky">
								<NavMenu />
							</MudPaper>
						</MudItem>

					</MudHidden>

					@* Main content *@
					<MudItem xs="12" md="8">

						<MudContainer>
							@Body
						</MudContainer>

					</MudItem>

					@* Right area (empty) *@
					<MudHidden Breakpoint="Breakpoint.SmAndDown">
						<MudItem xs="0" md="2">
							<MudPaper Class="nav-sticky"></MudPaper>
						</MudItem>
					</MudHidden>

				</MudGrid>
			</MudContainer>
		</MudHidden>


	</MudMainContent>
	
	@* Drawer nav menu mobile *@
	<MudDrawer @bind-Open="_drawerOpen"
	           Variant="DrawerVariant.Temporary"
	           Breakpoint="Breakpoint.Md"
	           ClipMode="DrawerClipMode.Always"
	           Anchor="Anchor.Left"
	           Overlay="true">
		<NavMenu/>
	</MudDrawer>
	
	@* Drawer settings menu mobile *@
	<MudDrawer @bind-Open="@_settingsOpen"
	           Anchor="Anchor.Right"
	           Variant="DrawerVariant.Temporary"
	           ClipMode="DrawerClipMode.Always"
	           Breakpoint="Breakpoint.Md"
	           Overlay="true">
		<MudDrawerHeader>
			<MudText Typo="Typo.h6">Settings</MudText>
		</MudDrawerHeader>
		<MudNavMenu>
			<AuthorizeView>
				<NotAuthorized>
					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pl-4 py-2">
						<MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small"/>
						<MudText>Dark mode</MudText>
						<MudSwitch T="bool" @bind-Value="_isDarkMode"
						           Color="Color.Primary"
						           Ripple="true"
						           Class="ms-auto"/>
					</MudStack>
					<MudNavLink Href="login" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
					<MudNavLink Href="register" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBox">Register</MudNavLink>
				</NotAuthorized>
				<Authorized>
					<MudNavLink Href="edit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Edit">Edit Profile</MudNavLink>
					<MudDivider></MudDivider>
					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pl-4 py-2">
						<MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small"/>
						<MudText>Dark mode</MudText>
						<MudSwitch T="bool" @bind-Value="_isDarkMode"
						           Color="Color.Primary"
						           Ripple="true"
						           Class="ms-auto"/>
					</MudStack>
					<MudNavLink Href="logout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
				</Authorized>
			</AuthorizeView>
		</MudNavMenu>
	</MudDrawer>

</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>