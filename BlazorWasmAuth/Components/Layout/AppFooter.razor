@using Frontend.ResourceFiles
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Resource> Localizer

<MudPaper Elevation="0" Class="app-footer">
	<MudContainer MaxWidth="MaxWidth.Large" >
		<MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center">

			<MudText Typo="Typo.caption">
				© 2025 ActioReact.io
			</MudText>

			<MudSpacer />

			<MudStack Row="true" Spacing="2">
				<MudLink Href="about" Typo="Typo.caption">@Localizer["About"]</MudLink>
				<MudLink Href="contact" Typo="Typo.caption">@Localizer["Contact"]</MudLink>
				<MudLink Href="privacy" Typo="Typo.caption">@Localizer["Privacy"]</MudLink>
			</MudStack>

		</MudContainer>
	</MudContainer>
</MudPaper>